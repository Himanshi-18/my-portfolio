              justifyContent="center"
              sx={{ mb: 4 }}
            >
              <StyledButton
                className="primary"
                startIcon={<MdEmail />}
                href="mailto:himanshirawat18@gmail.com"
              >
                Send Email
              </StyledButton>

              <StyledButton
                className="secondary"
