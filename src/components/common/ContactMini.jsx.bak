                title="GitHub"
              >
                <FaGithub />
              </SocialIcon>

              <SocialIcon
                as={motion.a}
                href="https://linkedin.com/in/himanshi-rawat"
                target="_blank"
                rel="noopener noreferrer"
                whileHover={{ scale: 1.1 }}
                whileTap={{ scale: 0.95 }}
                title="LinkedIn"
              >
                <FaLinkedin />
              </SocialIcon>

              <SocialIcon
                as={motion.a}
                href="https://twitter.com"
                target="_blank"
                rel="noopener noreferrer"
                whileHover={{ scale: 1.1 }}
                whileTap={{ scale: 0.95 }}
                title="Twitter"
              >
                <FaTwitter />
              </SocialIcon>

              <SocialIcon
                as={motion.a}
                href="mailto:himanshirawat18@gmail.com"
                whileHover={{ scale: 1.1 }}
                whileTap={{ scale: 0.95 }}
                title="Email"
              >
                <MdEmail />
              </SocialIcon>
            </IconBox>
          </motion.div>
        </motion.div>
      </Container>
    </SectionWrapper>
  );
};

            background: "linear-gradient(45deg, #00C6FF, #0072FF)",
            WebkitBackgroundClip: "text",
            WebkitTextFillColor: "transparent",
          }}
        >
          Let’s Build Something Amazing Together
        </Typography>

        <Typography
          variant="body1"
          sx={{
            maxWidth: 600,
            mx: "auto",
            color: "#94a3b8",
