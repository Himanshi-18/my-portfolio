import { Box, Typography, Button, Stack, Container } from "@mui/material";
import { motion } from "framer-motion";
import styled from "@emotion/styled";
import colors from "../../styles/color";
import { MdEmail } from "react-icons/md";
import { FaLinkedin, FaTwitter, FaGithub } from "react-icons/fa";
import { keyframes } from "@emotion/react";

/* Animations */
const float = keyframes`
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20px); }
`;

const glow = keyframes`
  0%, 100% { box-shadow: 0 0 20px rgba(0,217,255,0.3), 0 0 40px rgba(0,217,255,0.1); }
  50% { box-shadow: 0 0 40px rgba(0,217,255,0.6), 0 0 80px rgba(0,217,255,0.3); }
`;

/* ---------- Styled Section ---------- */

const SectionWrapper = styled(Box)`
  padding: 120px 0;
  position: relative;
  overflow: hidden;
  background: radial-gradient(
      circle at 30% 40%,
      rgba(0, 217, 255, 0.15),
      transparent 40%
    ),
    radial-gradient(
      circle at 70% 60%,
      rgba(0, 114, 255, 0.15),
      transparent 40%
    ),
    linear-gradient(180deg, #0f172a 0%, #020617 100%);
`;

const GlowBlob = styled(motion.div)`
  position: absolute;
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, rgba(0,217,255,0.3), transparent 70%);
  filter: blur(100px);
  top: -100px;
  right: -100px;
  animation: ${float} 6s ease-in-out infinite;
`;

const GlowBlobLeft = styled(motion.div)`
  position: absolute;
  width: 350px;
  height: 350px;
  background: radial-gradient(circle, rgba(0,114,255,0.2), transparent 70%);
  filter: blur(100px);
  bottom: -50px;
  left: -100px;
  animation: ${float} 8s ease-in-out infinite;
`;

const TitleWrapper = styled(motion.div)`
  margin-bottom: 24px;
`;

const MainTitle = styled(Typography)`
  font-weight: 800;
  font-size: 3rem;
  background: linear-gradient(135deg, #00d9ff, #0072ff, #ff006e);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: ${glow} 3s ease-in-out infinite;
  
  @media (max-width: 768px) {
    font-size: 1.8rem;
  }
`;

const SubtitleText = styled(Typography)`
  color: ${colors.lightGray};
  font-size: 1.1rem;
  line-height: 1.8;
  margin-top: 20px;
  margin-bottom: 40px;

  @media (max-width: 768px) {
    font-size: 1rem;
  }
`;

const StyledButton = styled(Button)`
  border-radius: 50px;
  padding: 12px 32px;
  font-weight: 600;
  text-transform: none;
  font-size: 1rem;
  transition: all 0.3s ease;
  
  &.primary {
    background: linear-gradient(135deg, #00d9ff, #0072ff);
    box-shadow: 0 8px 25px rgba(0, 217, 255, 0.3);
    
    &:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 40px rgba(0, 217, 255, 0.5);
    }
  }

  &.secondary {
    border: 2px solid rgba(0, 217, 255, 0.5);
    color: #00d9ff;
    
    &:hover {
      background: rgba(0, 217, 255, 0.1);
      border-color: #00d9ff;
      transform: translateY(-3px);
    }
  }
`;

const IconBox = styled(motion.div)`
  display: flex;
  gap: 20px;
  justify-content: center;
  margin-top: 40px;
  flex-wrap: wrap;
`;

const SocialIcon = styled(motion.a)`
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: rgba(0, 217, 255, 0.1);
  border: 2px solid rgba(0, 217, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #00d9ff;
  font-size: 1.5rem;
  transition: all 0.3s ease;
  text-decoration: none;
  cursor: pointer;

  &:hover {
    background: rgba(0, 217, 255, 0.2);
    border-color: #00d9ff;
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0, 217, 255, 0.3);
  }
`;

const ContactMini = () => {
